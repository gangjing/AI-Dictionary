{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Dictionary",
  "version": "1.0.0",
  "identifier": "com.aidictionary.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "AI Dictionary — 本地 AI 词典 (Hy-MT2)",
        "width": 1060,
        "height": 720,
        "minWidth": 820,
        "minHeight": 560,
        "resizable": true,
        "center": true
      },
      {
        "label": "popup",
        "title": "AI Dictionary Popup",
        "width": 420,
        "height": 290,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "focus": false
      },
      {
        "label": "ocr-overlay",
        "title": "OCR Region Selector",
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "fullscreen": true,
        "visible": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:*; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "msi", "nsis"],
    "resources": [
      "../data/dictionary.db"
    ],
    "externalBin": [
      "binaries/llama-server"
    ]
  }
}
